#!/workspace/.venv/bin/python
"""Explicit dev-only replacement for cb, used by the original world entrypoint."""
import os
import re
import sys
from pathlib import Path

if (sys.argv[1:] != ['serve', '--host', '0.0.0.0', '--port', '8023', '--no-frontend']
        or os.environ.get('CHI_DEV_PATIENT_SIMULATOR') != 'go-v1'
        or any(os.environ.get(k) for k in ('OPENCODE_API_KEY', 'ANTHROPIC_API_KEY', 'ANTHROPIC_AUTH_TOKEN'))):
    raise SystemExit('development_patient_launch_invalid')
cap_path = Path(os.environ.get('CHI_DEV_CAPABILITY_FILE', ''))
run = os.environ.get('CHI_DEV_RUN_ID', '')
if (not cap_path.is_absolute() or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,63}', run)
        or cap_path.is_symlink() or not cap_path.is_file()):
    raise SystemExit('development_patient_launch_invalid')
capability = cap_path.read_text(encoding='ascii').strip()
if not re.fullmatch(r'[A-Za-z0-9_-]{32,128}', capability): raise SystemExit('development_patient_launch_invalid')
from dev_patient_bootstrap import install
install(broker_url=os.environ.get('CHI_DEV_BROKER_URL', ''), capability=capability, run_id=run)
from chi_bench.cli import app
app(args=sys.argv[1:])
